# Copied to .env.stack.local by local.sh. Never use production credentials here.
LOCAL_RESOURCES_PORT=3304
LOCAL_SIMULATOR_PORT=3309
LOCAL_SIMULATOR_WORKERS=4
LOCAL_SIMULATOR_CPUS=4

# --app also starts the frontend, backend, search, ingest, Postgres and Redis.
LOCAL_FRONTEND_PORT=5275
LOCAL_BACKEND_PORT=3301
LOCAL_SEARCH_PORT=3302
LOCAL_INGEST_PORT=3303

# The FIRST --app startup imports this plain SQL file into a separate Docker volume. Unset, it
# is the backend's demo database with synthetic data (../umamoe-backend/dev/demo-database.sql).
# For a real snapshot, export one with pg_dump --no-owner --no-acl and point this at it.
# Paths are relative to this frontend folder, or absolute.
# LOCAL_DATABASE_DUMP=./.tmp/local-stack/database.sql
LOCAL_POSTGRES_PASSWORD=local-stack-only
LOCAL_SKIP_MIGRATIONS=false

# Backend development secrets; never use production credentials here.
LOCAL_JWT_SECRET=local-stack-jwt-for-development-only
LOCAL_BROWSER_PROOF_SECRET=local-stack-proof-for-development-only
