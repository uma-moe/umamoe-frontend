# Cloudflare Pages headers file
# https://developers.cloudflare.com/pages/configuration/headers/

# Revalidate the SPA shell so new hashed bundle references are picked up after deploys
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store

# Generated route shells and extensionless SPA entry URLs must follow the
# same policy as index.html. Hashed assets are overridden below.
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store

