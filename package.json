{
  "name": "umamoe-frontend",
  "version": "1.0.0",
  "description": "Uma.moe - Comprehensive Umamusume database with inheritance, support cards, tierlists, and tools",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "compress": "node scripts/compress-images.js",
    "sync:planner-item-icons": "node scripts/sync-planner-item-icons.mjs",
    "build": "npm run generate:favicon && npm run precompute && ng build && npm run generate:seo && npm run compress",
    "build:prod": "npm run generate:favicon && npm run precompute && ng build --configuration production && npm run generate:seo && npm run compress",
    "build:beta": "npm run generate:favicon && npm run precompute && ng build --configuration beta && npm run generate:seo && npm run compress",
    "build:dev": "npm run generate:favicon && ng build",
    "build:profile": "npm run precompute && ng build --configuration profile",
    "build:audit": "npm run precompute && ng build --configuration audit --stats-json",
    "precompute": "node scripts/precompute-tierlist.js",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:seo": "node scripts/generate-seo-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "serve:prod": "ng serve --configuration production",
    "serve:profile": "ng serve --configuration profile",
    "serve:audit": "ng serve --configuration audit --host 127.0.0.1 --port 4317",
    "audit:bundle": "npm run build:audit && node scripts/frontend-audit/check-bundles.mjs",
    "audit:bundle:report": "npm run build:audit && node scripts/frontend-audit/check-bundles.mjs --report-only",
    "audit:duplicates": "node scripts/frontend-audit/check-duplicates.mjs",
    "audit:routes": "playwright test",
    "audit:cpu": "node scripts/frontend-audit/profile-cpu.mjs",
    "audit:cpu:deep": "node scripts/frontend-audit/profile-deep-cpu.mjs",
    "audit:lighthouse": "npm run build:audit && node scripts/frontend-audit/run-lighthouse.mjs",
    "audit:lighthouse:live": "node scripts/frontend-audit/run-lighthouse.mjs --live",
    "audit:frontend": "node scripts/frontend-audit/run-frontend-audit.mjs"
  },
  "keywords": [
    "uma-musume",
    "gacha",
    "tierlist",
    "inheritance",
    "support-cards",
    "simulator",
    "angular"
  ],
  "author": "Tunnelblick",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource/material-icons": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "exceljs": "^4.4.0",
    "ngx-ui-tour-md-menu": "12.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "~5.1.0",
    "archiver": "^7.0.1",
    "jasmine-core": "~5.1.0",
    "jscpd": "5.0.14",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.4.2"
  }
}
