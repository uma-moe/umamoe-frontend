# Copy to .env.development.local for local testing.
# Only local development reads this key; beta and production use browser verification.
# The key is added by Vite's server-side proxy and is never sent to the browser.
SIMULATOR_API_KEY=

# Local resimulation requests use the beta service.
VITE_SIM_PROXY_TARGET=https://beta.uma.moe

# Set false to stop the What's new release dialog from opening by itself in development.
# The footer's What's new link still opens it.
VITE_UPDATE_NOTIFICATION=true
