{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/browser",
      "isSinglePageApplication": true,
      "url": [
        "http://localhost/database",
        "http://localhost/timeline",
        "http://localhost/tools/statistics",
        "http://localhost/tools/lineage-planner"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage",
        "maxWaitForLoad": 60000,
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 3, "disabled": false }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1800, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "reports/lighthouse/mobile-heavy" }
  }
}
